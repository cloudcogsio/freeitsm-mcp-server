{
  "name": "freeitsm-mcp-server",
  "version": "0.1.0",
  "description": "Standalone MCP server for the FreeITSM REST API (v1). Everything it can do is governed by the API key it is given.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "freeitsm",
    "itsm",
    "helpdesk"
  ],
  "author": "Ricardo Assing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudcogsio/freeitsm-mcp-server.git"
  },
  "homepage": "https://github.com/cloudcogsio/freeitsm-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cloudcogsio/freeitsm-mcp-server/issues"
  },
  "type": "module",
  "bin": {
    "freeitsm-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "npm run build && tsx --test test/unit.test.ts test/server.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures": "tsx scripts/fixtures.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
